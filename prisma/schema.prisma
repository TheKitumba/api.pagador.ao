// pagador.ao — data model (docs/06-modelo-de-dados.md).
// Conventions: snake_case tables and columns, UUID v7 ids, money as Decimal(18,2),
// tenant_id on every business table (isolated by PostgreSQL Row-Level Security).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity & access (global tables: not tenant-isolated)
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  ACCOUNT_ADMIN
  HR_MANAGER
  HR_TECHNICIAN
  PAYROLL_PROCESSOR
  FINANCIAL_APPROVER
  LINE_MANAGER
  RECRUITER
  EMPLOYEE
  AUDITOR
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}

model Tenant {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  plan      String   @default("PROFESSIONAL")
  createdAt DateTime @default(now()) @map("created_at")

  memberships Membership[]
  companies   Company[]

  @@map("tenants")
}

model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  name             String
  email            String?    @unique
  phone            String?    @unique
  passwordHash     String?    @map("password_hash")
  status           UserStatus @default(ACTIVE)
  failedLogins     Int        @default(0) @map("failed_logins")
  lockedUntil      DateTime?  @map("locked_until")
  totpSecret       String?    @map("totp_secret")
  twoFactorEnabled Boolean    @default(false) @map("two_factor_enabled")
  lastLoginAt      DateTime?  @map("last_login_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  memberships   Membership[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Membership {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  companyId  String?   @map("company_id") @db.Uuid
  employeeId String?   @map("employee_id") @db.Uuid
  roles      Role[]
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@map("memberships")
}

model RefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by") @db.Uuid
  userAgent  String?   @map("user_agent")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

enum OtpPurpose {
  LOGIN
  PASSWORD_RESET
}

model OneTimeCode {
  id         String     @id @default(uuid(7)) @db.Uuid
  identifier String
  purpose    OtpPurpose
  codeHash   String     @map("code_hash")
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at")
  usedAt     DateTime?  @map("used_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([identifier, purpose])
  @@map("one_time_codes")
}

model Invitation {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  email      String
  roles      Role[]
  tokenHash  String    @unique @map("token_hash")
  invitedBy  String    @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("invitations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Reference data (global)
// ─────────────────────────────────────────────────────────────────────────────

model Bank {
  code       String  @id
  name       String
  swift      String?
  fileFormat String  @map("file_format")

  @@map("banks")
}

model Province {
  name           String   @id
  municipalities String[]

  @@map("provinces")
}

enum LegalTableKind {
  IRT_GROUP_A
  SOCIAL_SECURITY
  MINIMUM_WAGE
  IRT_EXEMPTIONS
  OVERTIME_RATES
  HOLIDAYS
  CONTRACTOR_WITHHOLDING
}

/// Versioned legal parameters. tenant_id NULL = global table maintained by pagador.ao.
model LegalTable {
  id             String         @id @default(uuid(7)) @db.Uuid
  tenantId       String?        @map("tenant_id") @db.Uuid
  kind           LegalTableKind
  version        String
  effectiveFrom  DateTime       @map("effective_from") @db.Date
  effectiveTo    DateTime?      @map("effective_to") @db.Date
  legalReference String         @map("legal_reference")
  data           Json
  approvedBy     String?        @map("approved_by")
  approvedAt     DateTime?      @map("approved_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([kind, effectiveFrom])
  @@map("legal_tables")
}

// ─────────────────────────────────────────────────────────────────────────────
// Organization
// ─────────────────────────────────────────────────────────────────────────────

enum CompanySize {
  MICRO
  SMALL
  MEDIUM
  LARGE
}

model Company {
  id                   String      @id @default(uuid(7)) @db.Uuid
  tenantId             String      @map("tenant_id") @db.Uuid
  legalName            String      @map("legal_name")
  tradeName            String      @map("trade_name")
  nif                  String
  socialSecurityNumber String?     @map("social_security_number")
  activityCode         String?     @map("activity_code")
  sizeClass            CompanySize @default(SMALL) @map("size_class")
  province             String?
  address              String?
  careersSlug          String?     @unique @map("careers_slug")
  defaultCurrency      String      @default("AOA") @map("default_currency")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, nif])
  @@map("companies")
}

model Establishment {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  name       String
  province   String?
  address    String?
  latitude   Decimal?  @db.Decimal(9, 6)
  longitude  Decimal?  @db.Decimal(9, 6)
  geoPunch   Boolean   @default(true) @map("geo_punch")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("establishments")
}

model CostCenter {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  code       String
  name       String
  archivedAt DateTime? @map("archived_at")

  @@unique([companyId, code])
  @@map("cost_centers")
}

enum OrgUnitKind {
  DIRECTORATE
  DEPARTMENT
  SECTION
}

model OrgUnit {
  id             String      @id @default(uuid(7)) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  companyId      String      @map("company_id") @db.Uuid
  parentId       String?     @map("parent_id") @db.Uuid
  kind           OrgUnitKind @default(DEPARTMENT)
  name           String
  headEmployeeId String?     @map("head_employee_id") @db.Uuid
  costCenterId   String?     @map("cost_center_id") @db.Uuid
  archivedAt     DateTime?   @map("archived_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  @@map("org_units")
}

model JobPosition {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  title      String
  orgUnitId  String?   @map("org_unit_id") @db.Uuid
  grade      String?
  archivedAt DateTime? @map("archived_at")

  @@map("job_positions")
}

enum ScheduleType {
  FIXED
  FLEXIBLE
  SHIFT
  ROTATION
}

model WorkSchedule {
  id               String       @id @default(uuid(7)) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  companyId        String       @map("company_id") @db.Uuid
  name             String
  type             ScheduleType @default(FIXED)
  weeklyHours      Decimal      @default(44) @map("weekly_hours") @db.Decimal(5, 2)
  startTime        String?      @map("start_time")
  endTime          String?      @map("end_time")
  days             String[]
  toleranceMinutes Int          @default(10) @map("tolerance_minutes")
  archivedAt       DateTime?    @map("archived_at")

  @@map("work_schedules")
}

enum ShiftKind {
  MORNING
  AFTERNOON
  NIGHT
  OFF
}

model ShiftAssignment {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  date       DateTime  @db.Date
  shift      ShiftKind

  @@unique([employeeId, date])
  @@map("shift_assignments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Workforce
// ─────────────────────────────────────────────────────────────────────────────

enum EmployeeStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum Gender {
  FEMALE
  MALE
}

enum IdDocumentType {
  BI
  PASSPORT
  RESIDENT_CARD
}

model Employee {
  id                   String         @id @default(uuid(7)) @db.Uuid
  tenantId             String         @map("tenant_id") @db.Uuid
  companyId            String         @map("company_id") @db.Uuid
  employeeNumber       String         @map("employee_number")
  fullName             String         @map("full_name")
  gender               Gender?
  birthDate            DateTime?      @map("birth_date") @db.Date
  maritalStatus        String?        @map("marital_status")
  nationality          String         @default("AO")
  idDocumentType       IdDocumentType @default(BI) @map("id_document_type")
  idDocumentNumber     String?        @map("id_document_number")
  idDocumentExpiry     DateTime?      @map("id_document_expiry") @db.Date
  nif                  String?
  socialSecurityNumber String?        @map("social_security_number")
  phone                String?
  email                String?
  province             String?
  municipality         String?
  address              String?
  hireDate             DateTime       @map("hire_date") @db.Date
  seniorityDate        DateTime?      @map("seniority_date") @db.Date
  status               EmployeeStatus @default(ACTIVE)
  positionId           String?        @map("position_id") @db.Uuid
  orgUnitId            String?        @map("org_unit_id") @db.Uuid
  establishmentId      String?        @map("establishment_id") @db.Uuid
  costCenterId         String?        @map("cost_center_id") @db.Uuid
  managerId            String?        @map("manager_id") @db.Uuid
  scheduleId           String?        @map("schedule_id") @db.Uuid
  dependents           Int            @default(0)
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  contracts    EmploymentContract[]
  bankAccounts BankAccount[]
  documents    EmployeeDocument[]

  @@unique([companyId, employeeNumber])
  @@index([tenantId, status])
  @@map("employees")
}

enum ContractType {
  INDEFINITE
  FIXED_TERM
  UNCERTAIN_TERM
  PART_TIME
  INTERNSHIP
  TEMPORARY
  NON_RESIDENT
}

enum ContractStatus {
  DRAFT
  ACTIVE
  ENDED
  TERMINATED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  MOBILE_WALLET
  CHEQUE
}

model EmploymentContract {
  id               String         @id @default(uuid(7)) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  employeeId       String         @map("employee_id") @db.Uuid
  contractType     ContractType   @map("contract_type")
  status           ContractStatus @default(ACTIVE)
  startDate        DateTime       @map("start_date") @db.Date
  endDate          DateTime?      @map("end_date") @db.Date
  probationEndDate DateTime?      @map("probation_end_date") @db.Date
  renewalsCount    Int            @default(0) @map("renewals_count")
  positionId       String?        @map("position_id") @db.Uuid
  baseSalary       Decimal        @map("base_salary") @db.Decimal(18, 2)
  currency         String         @default("AOA")
  weeklyHours      Decimal        @default(44) @map("weekly_hours") @db.Decimal(5, 2)
  paymentMethod    PaymentMethod  @default(BANK_TRANSFER) @map("payment_method")
  terminationDate  DateTime?      @map("termination_date") @db.Date
  notes            String?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  employee Employee          @relation(fields: [employeeId], references: [id])
  payItems ContractPayItem[]

  @@index([tenantId, endDate])
  @@map("employment_contracts")
}

model BankAccount {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  bankCode     String    @map("bank_code")
  iban         String
  holderName   String    @map("holder_name")
  splitPercent Int       @default(100) @map("split_percent")
  isPrimary    Boolean   @default(true) @map("is_primary")
  validatedAt  DateTime? @map("validated_at")
  changedAt    DateTime  @default(now()) @map("changed_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("bank_accounts")
}

model EmployeeDocument {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  employeeId  String    @map("employee_id") @db.Uuid
  category    String
  fileName    String    @map("file_name")
  contentType String    @map("content_type")
  size        Int
  storageKey  String    @map("storage_key")
  expiresAt   DateTime? @map("expires_at") @db.Date
  uploadedBy  String?   @map("uploaded_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_documents")
}

enum TerminationReason {
  CONTRACT_EXPIRY
  EMPLOYEE_RESIGNATION
  DISCIPLINARY_DISMISSAL
  OBJECTIVE_DISMISSAL
  MUTUAL_AGREEMENT
  RETIREMENT
  DEATH
}

enum TerminationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
  CANCELLED
}

model Termination {
  id              String            @id @default(uuid(7)) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  employeeId      String            @map("employee_id") @db.Uuid
  reason          TerminationReason
  noticeDate      DateTime          @map("notice_date") @db.Date
  lastDay         DateTime          @map("last_day") @db.Date
  settlement      Json?
  settlementTotal Decimal?          @map("settlement_total") @db.Decimal(18, 2)
  status          TerminationStatus @default(PENDING_APPROVAL)
  notes           String?
  createdBy       String            @map("created_by") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")

  @@map("terminations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Time: attendance, leave, overtime, timesheets
// ─────────────────────────────────────────────────────────────────────────────

enum PunchType {
  IN
  OUT
}

enum PunchSource {
  WEB
  KIOSK
  BIOMETRIC
  MANUAL
  API
}

model AttendanceRecord {
  id             String      @id @default(uuid(7)) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  employeeId     String      @map("employee_id") @db.Uuid
  timestamp      DateTime
  type           PunchType
  source         PunchSource
  latitude       Decimal?    @db.Decimal(9, 6)
  longitude      Decimal?    @db.Decimal(9, 6)
  userAgent      String?     @map("user_agent")
  idempotencyKey String?     @map("idempotency_key")
  createdAt      DateTime    @default(now()) @map("created_at")

  @@unique([tenantId, idempotencyKey])
  @@index([employeeId, timestamp])
  @@map("attendance_records")
}

enum RequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

model AttendanceCorrection {
  id         String        @id @default(uuid(7)) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  employeeId String        @map("employee_id") @db.Uuid
  date       DateTime      @db.Date
  type       PunchType
  time       String
  reason     String
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now()) @map("created_at")

  @@map("attendance_corrections")
}

model AttendancePeriod {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  year      Int
  month     Int
  closedAt  DateTime? @map("closed_at")
  closedBy  String?   @map("closed_by") @db.Uuid
  summary   Json?

  @@unique([companyId, year, month])
  @@map("attendance_periods")
}

enum LeaveType {
  VACATION
  SICK
  MARRIAGE
  BEREAVEMENT
  MATERNITY
  PATERNITY
  UNPAID
  UNJUSTIFIED
  OTHER_JUSTIFIED
}

model LeaveRequest {
  id         String        @id @default(uuid(7)) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  employeeId String        @map("employee_id") @db.Uuid
  type       LeaveType
  startDate  DateTime      @map("start_date") @db.Date
  endDate    DateTime      @map("end_date") @db.Date
  days       Int
  justified  Boolean       @default(true)
  paid       Boolean       @default(true)
  reason     String?
  documentId String?       @map("document_id") @db.Uuid
  status     RequestStatus @default(PENDING)
  createdBy  String?       @map("created_by") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([tenantId, status])
  @@map("leave_requests")
}

model LeaveBalance {
  id           String @id @default(uuid(7)) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  employeeId   String @map("employee_id") @db.Uuid
  year         Int
  entitledDays Int    @default(22) @map("entitled_days")
  carriedOver  Int    @default(0) @map("carried_over")
  taken        Int    @default(0)
  scheduled    Int    @default(0)

  @@unique([employeeId, year])
  @@map("leave_balances")
}

enum OvertimeKind {
  WEEKDAY
  REST_DAY
  HOLIDAY
  NIGHT
}

model OvertimeRequest {
  id         String        @id @default(uuid(7)) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  employeeId String        @map("employee_id") @db.Uuid
  date       DateTime      @db.Date
  minutes    Int
  kind       OvertimeKind
  reason     String
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now()) @map("created_at")

  @@map("overtime_requests")
}

model Timesheet {
  id         String        @id @default(uuid(7)) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  employeeId String        @map("employee_id") @db.Uuid
  weekStart  DateTime      @map("week_start") @db.Date
  project    String
  hours      Decimal       @db.Decimal(5, 2)
  notes      String?
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now()) @map("created_at")

  @@map("timesheets")
}

// ─────────────────────────────────────────────────────────────────────────────
// Approvals (doc 05, 5.5)
// ─────────────────────────────────────────────────────────────────────────────

enum ApprovalType {
  LEAVE
  OVERTIME
  ADVANCE
  LOAN
  EXPENSE
  SALARY_CHANGE
  PAYROLL_RUN
  PAYMENT_BATCH
  TERMINATION
  ATTENDANCE_CORRECTION
  TIMESHEET
}

model ApprovalWorkflow {
  id       String       @id @default(uuid(7)) @db.Uuid
  tenantId String       @map("tenant_id") @db.Uuid
  type     ApprovalType
  /// Ordered steps: [{ approver: "LINE_MANAGER" | Role, rule: "ANY" | "ALL", slaHours }]
  steps    Json

  @@unique([tenantId, type])
  @@map("approval_workflows")
}

model ApprovalRequest {
  id              String        @id @default(uuid(7)) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  type            ApprovalType
  subjectId       String        @map("subject_id") @db.Uuid
  title           String
  detail          String?
  requesterUserId String?       @map("requester_user_id") @db.Uuid
  beneficiaryId   String?       @map("beneficiary_employee_id") @db.Uuid
  /// Snapshot at request time, so approvals never read workforce tables.
  beneficiaryName String?       @map("beneficiary_name")
  beneficiaryManagerId String?  @map("beneficiary_manager_id") @db.Uuid
  /// Users that may never approve this request (segregation of duties).
  excludedUserIds String[]      @map("excluded_user_ids")
  steps           Json
  currentStep     Int           @default(0) @map("current_step")
  status          RequestStatus @default(PENDING)
  dueAt           DateTime?     @map("due_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  decidedAt       DateTime?     @map("decided_at")

  actions ApprovalAction[]

  @@index([tenantId, status])
  @@map("approval_requests")
}

model ApprovalAction {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  requestId   String   @map("request_id") @db.Uuid
  step        Int
  actorUserId String   @map("actor_user_id") @db.Uuid
  decision    String
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  request ApprovalRequest @relation(fields: [requestId], references: [id])

  @@map("approval_actions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Payroll (doc 04)
// ─────────────────────────────────────────────────────────────────────────────

enum PayItemKind {
  EARNING
  DEDUCTION
  EMPLOYER_CHARGE
  INFORMATIVE
}

enum PayItemNature {
  FIXED
  VARIABLE
  CALCULATED
}

enum PayItemCategory {
  SALARY
  ALLOWANCE
  BENEFIT
  INSURANCE
  OVERTIME
  BONUS
  STATUTORY
  ABSENCE
  LOAN
  OTHER
}

model PayItem {
  id                 String          @id @default(uuid(7)) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  companyId          String          @map("company_id") @db.Uuid
  code               String
  name               String
  kind               PayItemKind
  nature             PayItemNature
  category           PayItemCategory @default(OTHER)
  formula            String?
  irtSubject         Boolean         @default(true) @map("irt_subject")
  irtExemptionLimit  Decimal?        @map("irt_exemption_limit") @db.Decimal(18, 2)
  ssSubject          Boolean         @default(true) @map("ss_subject")
  holidayAllowance   Boolean         @default(false) @map("holiday_allowance_base")
  christmasAllowance Boolean         @default(false) @map("christmas_allowance_base")
  proportional       Boolean         @default(false)
  accountingAccount  String?         @map("accounting_account")
  calculationOrder   Int             @default(100) @map("calculation_order")
  visibleOnPayslip   Boolean         @default(true) @map("visible_on_payslip")
  effectiveFrom      DateTime        @default(now()) @map("effective_from") @db.Date
  effectiveTo        DateTime?       @map("effective_to") @db.Date
  archivedAt         DateTime?       @map("archived_at")

  @@unique([companyId, code])
  @@map("pay_items")
}

model ContractPayItem {
