{
  "name": "api.pagador.ao",
  "version": "0.0.1",
  "description": "pagador.ao API — Angolan HR & payroll (NestJS, DDD)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "docker compose up -d postgres redis minio && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "nest start --watch --entryFile worker",
    "start:worker:prod": "node dist/worker",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "ts-node -r tsconfig-paths/register src/seed.ts",
    "db:seed:prod": "node dist/seed",
    "keys:generate": "mkdir -p keys && openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/jwt-private.pem && openssl rsa -in keys/jwt-private.pem -pubout -out keys/jwt-public.pem",
    "lint": "eslint \"src/**/*.ts\" --fix"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.7",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "6.13.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "bullmq": "^6.3.14",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.6.0",
    "handlebars": "^4.7.10",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "nestjs-cls": "^7.0.1",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.1.0",
    "otplib": "^13.5.0",
    "pdfkit": "^0.20.2",
    "prisma": "^6.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register src/seed.ts"
  },
  "packageManager": "pnpm@11.24.0"
}
