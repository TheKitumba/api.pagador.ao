# HTTP
PORT=3333
NODE_ENV=development
# Origins allowed to call the API with cookies (comma separated)
CORS_ORIGINS=http://localhost:3000
# Parent domain for auth cookies in production (e.g. .pagador.ao); empty in development
COOKIE_DOMAIN=

# PostgreSQL
DATABASE_URL=postgresql://local_user:local_password@localhost:5432/local_db?schema=public

# Redis (BullMQ queues, Socket.IO adapter)
REDIS_URL=redis://localhost:6379

# JWT — RS256 key pair (PEM files). Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/jwt-private.pem
#   openssl rsa -in keys/jwt-private.pem -pubout -out keys/jwt-public.pem
JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem
JWT_ISSUER=https://api.pagador.ao
JWT_AUDIENCE=pagador.ao
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# MinIO / S3-compatible object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=local_minio
S3_SECRET_KEY=local_minio_password
S3_BUCKET=pagador
S3_FORCE_PATH_STYLE=true

# E-mail — Nodemailer with Gmail SMTP. Use a Google "app password"
# (Google account → Security → 2-Step Verification → App passwords), not the account password.
MAIL_FROM="pagador.ao <no-reply@pagador.ao>"
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Handlebars e-mail templates, relative to the working directory
MAIL_TEMPLATES_DIR=templates/emails
# Base URL of the frontend, used in e-mail links (invitations, password reset)
APP_URL=http://localhost:3000
