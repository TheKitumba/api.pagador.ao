{{!-- Label/value list on a muted panel. Usage: {{#> details}}{{> detail label="…" value=…}}{{/details}} --}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="bg-muted" style="margin:0 0 8px; background-color:#f3f4f6; border-radius:10px;">
  <tr>
    <td style="padding:6px 16px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        {{> @partial-block }}
      </table>
    </td>
  </tr>
</table>
