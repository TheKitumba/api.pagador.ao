{{!-- Tinted status box, same palette as the Badge variants: info | success | warning | danger. --}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 16px; border-collapse:separate;">
  <tr>
    <td class="callout-{{variant}}" style="padding:12px 14px; border-radius:10px; font-size:14px; line-height:20px; {{calloutStyle variant}}">{{> @partial-block }}</td>
  </tr>
</table>
