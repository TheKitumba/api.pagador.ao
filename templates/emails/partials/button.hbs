{{!-- Button variant "default" (bg-primary, rounded-lg), table-based so it renders in Outlook. --}}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0;">
  <tr>
    <td class="btn-primary" bgcolor="#1570ef" style="border-radius:10px; background-color:#1570ef; box-shadow:0 1px 2px 0 rgba(16,24,40,0.05);">
      <a href="{{href}}" target="_blank" style="display:inline-block; padding:11px 20px; font-size:14px; line-height:18px; font-weight:500; color:#ffffff; text-decoration:none; border-radius:10px;">{{label}}</a>
    </td>
  </tr>
</table>
